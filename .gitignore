# Specify filepatterns you want git to ignore.
.idea/*
.DS_Store

# Python仮想環境（ローカルサーバー用）
.venv/

# kannaigai18 ビルド生成物（GitHub Actionsで生成。手書きのpreviewは除外しない）
/kannaigai18/index.html
/kannaigai18/news/*/index.html
!/kannaigai18/news/preview/index.html
# ローカルビルド用の環境変数
/kannaigai18/.env

# デザイン原本（重量物。Web用の書き出しは image/ 以下にコミット済み）
*.psd
*.psb
*.ai
/kannaigai18/ito_kv_psd_18_0831/
# デザイン参考資料（チラシ・参考画像など。公開しない）
/_refarence/
/_reference/

# 機密・内部資料（公開リポジトリへの誤コミット防止）
# 表計算・文書ファイル（予算書・決算書・契約書・プレスリリース等）
*.xlsx
*.xls
*.docx
*.doc
*.pdf
# ファイル名に機密キーワードを含むもの
*予算*
*決算*
*収支*
*見積*
*契約*
*個人情報*
*機密*


# 旧サイト（kannaigai11〜16）移行分の公開済みPDF（チラシ・プログラム）は例外として管理する
!/kannaigai11/pdf/*.pdf
!/kannaigai11/wp-content/themes/kannaigaigai11_v1.0/pdf/*.pdf
!/kannaigai14/images/kannaigai14_pamphlet.pdf
!/kannaigai16/images/kannaiga16-program-a3.pdf
# 第10回（旧サイト移行分）の公開済みPDF（会場マップ・タイムテーブル）
!/kannaigai10/pdf/*.pdf
!/kannaigai10/wp-content/themes/kannaigaigai8_v3/pdf/*.pdf
